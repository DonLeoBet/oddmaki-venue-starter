{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/fetch-matches",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/fetch-outrights",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/resolution-alerts",
      "schedule": "*/15 * * * *"
    }
  ]
}