# =============================================================================
# Poly.Football — production env (copy to server / Vercel)
# =============================================================================

# --- Core (required) ---
NEXT_PUBLIC_VENUE_ID=6
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_GRAPH_API_KEY=

# --- Brand (Poly.Football) ---
NEXT_PUBLIC_BRAND_ID=polyfootball
NEXT_PUBLIC_BRAND_NAME=Poly.Football
NEXT_PUBLIC_BRAND_DOMAIN=poly.football
NEXT_PUBLIC_DEFAULT_LANGUAGE=nl
NEXT_PUBLIC_BRAND_LOGO_URL=/logo.png

# --- Brand (TopClass) ---
# NEXT_PUBLIC_BRAND_ID=topclass
# NEXT_PUBLIC_BRAND_NAME=TopClass
# NEXT_PUBLIC_BRAND_DOMAIN=topclass.bet
# NEXT_PUBLIC_DEFAULT_LANGUAGE=en
# NEXT_PUBLIC_BRAND_LOGO_URL=/topclass-logo-transparent.png

# --- Auth: Privy = Gmail/X login + embedded wallet (no KYC) ---
NEXT_PUBLIC_AUTH_PROVIDER=privy
NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_ENABLE_FIAT_ONRAMP=true   # only if you want card/bank (KYC)

# --- Optional: RainbowKit wallet-only mode (no social login, no Top Up) ---
# NEXT_PUBLIC_AUTH_PROVIDER=rainbowkit
# NEXT_PUBLIC_WALLETCONNECT_ID=          # from https://cloud.reown.com
# Add https://poly.football to Reown allowlist when using WalletConnect

# --- RPC (recommended — avoids rate limits for cron bot) ---
NEXT_PUBLIC_RPC_URL=
BOT_RPC_URL=
# RPC_CONCURRENCY_LIMIT=5
# RPC_BALANCE_CACHE_TTL_MS=15000
# RPC_STATIC_CACHE_TTL_MS=300000
# IMPORT_BATCH_SIZE=10
# IMPORT_BATCH_DELAY_MS=1500
# RPC_CACHE_DEBUG=1

# --- Football bot (server-only, never expose to browser) ---
FOOTBALL_API_KEY=
OPERATOR_BOT_MNEMONIC=

# --- API auth (shared-secret Bearer tokens) — set in Vercel Environment Variables ---
#
# ADMIN_SECRET:
#   - Server-only. Used by /api/admin/* (curl/automation) and admin UI login.
#   - Admin UI: operators enter this once at /admin → httpOnly session cookie.
#   - Generate: openssl rand -hex 32
#   - Do NOT set NEXT_PUBLIC_* — never expose admin secret in the browser bundle.
#
# CRON_SECRET:
#   - Separate random value for /api/cron/* (Vercel Cron sends Bearer automatically).
#
ADMIN_SECRET=
CRON_SECRET=

# --- Outright / fixture cron ---
OUTRIGHT_SEASON_YEAR=2026
OUTRIGHT_TAG_REVISION=v2
FIXTURE_MIN_KICKOFF_DATE=2026-08-15
CRON_FIXTURE_DAYS_AHEAD=30
